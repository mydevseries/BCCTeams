# Environment
NODE_ENV=development
PORT=3000
WEB_URL=http://localhost:5173
API_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bccteams?schema=public"

# Redis (Cache, Pub/Sub, Presence)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# S3 / SeaweedFS Storage
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=any
S3_SECRET_KEY=any
S3_BUCKET=bccteams

# LiveKit (Meetings & Video Calls)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=http://localhost:7880

# JWT Secrets
JWT_SECRET=bcc_teams_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=bcc_teams_super_secret_refresh_jwt_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d
